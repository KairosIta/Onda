# Copia questo file in .env e inserisci i tuoi valori.
# .env e' in .gitignore: non finira' mai su GitHub.

# Registrati su https://devportal.jamendo.com e crea un'applicazione.
EXPO_PUBLIC_JAMENDO_CLIENT_ID=inserisci_il_tuo_client_id

# Nome applicazione richiesto da Audius su ogni chiamata.
EXPO_PUBLIC_AUDIUS_APP_NAME=Onda
